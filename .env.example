# Meridian Control Tower — Supabase (Sprint 2). Copy to .env.local and fill in.
# Get these from Supabase: Project Settings → API.
# .env.local is gitignored — never commit real keys.

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon public" key — safe for the browser (RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key — SERVER ONLY. Powers server actions + maker-checker
# enforcement. Never expose to the client, never commit.
SUPABASE_SERVICE_ROLE_KEY=
